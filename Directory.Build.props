<Project>

  <!-- Shared assembly metadata for every project in the solution. Set here so
       authorship and version stay consistent across the server, overlay, CLI
       and simulator without repeating it in each .csproj. -->
  <PropertyGroup>
    <Authors>nekron</Authors>
    <Company>nekron</Company>
    <Product>Quantum Wake</Product>
    <Copyright>Copyright © nekron</Copyright>
    <Description>A pilot's logbook for Star Citizen: second-screen dashboard, in-game overlay, and flight-log analysis for Star Citizen, driven by Game.log.</Description>

    <Version>0.9.12</Version>
    <AssemblyVersion>0.9.12.0</AssemblyVersion>
    <FileVersion>0.9.12.0</FileVersion>

    <RepositoryUrl>https://github.com/peans99/QuantumWake</RepositoryUrl>
    <PackageProjectUrl>https://github.com/peans99/QuantumWake</PackageProjectUrl>
  </PropertyGroup>

</Project>
