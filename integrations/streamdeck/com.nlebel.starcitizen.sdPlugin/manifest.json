{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Star Citizen Commands",
  "Version": "1.1.3.0",
  "Author": "Nicolas Lebel",
  "Description": "Star Citizen commands with keyboard and mouse bindings generated by Quantum Wake.",
  "UUID": "com.nlebel.starcitizen",
  "Icon": "imgs/plugin/icon",
  "Category": "Star Citizen Commands",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.nlebel.starcitizen.command",
      "Name": "SC Command",
      "Icon": "imgs/actions/command",
      "Tooltip": "Send a Star Citizen command (pick it in the settings below)",
      "PropertyInspectorPath": "ui/command.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/key",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    }
  ]
}