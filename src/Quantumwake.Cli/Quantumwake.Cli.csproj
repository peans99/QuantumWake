<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Quantumwake.Core\Quantumwake.Core.csproj" />
    <ProjectReference Include="..\Quantumwake.Data\Quantumwake.Data.csproj" />
    <!-- For the ocr command: the screen reader run over a folder of screenshots, the way
         the backups are run through the parser. -->
    <ProjectReference Include="..\Quantumwake.Ocr.Onnx\Quantumwake.Ocr.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded voice's list of clips, for the report's check that every
         name the voice can say has one (1.2.56). Only the list: the clips live
         in the Windows-only Quantumwake.Ocr, and this tool runs on Linux too. -->
    <EmbeddedResource Include="..\Quantumwake.Ocr\Voices\af_bella\manifest.json" LogicalName="voice-manifest.json" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
