<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows SDK target is what puts Windows.Media.Ocr in reach, and it
         needs no package: the engine and its English model are already on the
         machine (Windows\OCR\en-us\MsOcrRes.orp). This project exists so that
         one target framework does not spread to the server and the parser
         tests, which have no business being Windows-only. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Clipboard lives in WPF, and the overlay is a WPF app already. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- The recorded callout voice, inside the assembly: a single-file build has
       no folder beside it. Named by path with forward slashes, so a lookup
       does not depend on how the build spells a directory. -->
  <ItemGroup>
    <EmbeddedResource Include="Voices\**\*">
      <LogicalName>Voices/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quantumwake.Data\Quantumwake.Data.csproj" />
  </ItemGroup>

</Project>
