<Project Sdk="Microsoft.NET.Sdk">

  <!-- The wire format both sides of the org network compile against, and
       nothing else. Deliberately dependency-free: the org server must not
       inherit the parser, and the client must not inherit a web stack, so the
       one project they share carries records, caps and text hygiene only. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quantumwake.OrgServer.Tests" />
  </ItemGroup>

</Project>
