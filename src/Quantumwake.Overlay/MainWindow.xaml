<Window x:Class="Quantumwake.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Quantum Wake Overlay"
        Width="360" Height="460"
        MinWidth="230" MinHeight="150"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0A121C"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <!-- The outer border is the resize gutter. WebView2 is inset by GutterWidth
         so it never covers the window edges - without that inset the browser
         control swallows the hit-testing that resizing depends on.

         The window is deliberately NOT AllowsTransparency: WebView2 does not
         support it, and in that mode clicks over the browser are dropped before
         it ever sees them. Translucency comes from a uniform layered alpha on
         the HWND instead. See NativeWindowStyles.SetWindowAlpha. -->
    <Border x:Name="Frame" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown only while interactive: drag handle, hint and close. -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#F00A121C"
                    BorderBrush="#1E4763"
                    BorderThickness="1,1,1,0"
                    Height="26" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <Rectangle Width="7" Height="7" Fill="#35C8F0"
                                   RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="INTERACTIVE"
                                   Foreground="#7FE4FF"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                        <TextBlock Text="DRAG TO MOVE  ·  EDGES TO RESIZE  ·  CTRL+ALT+←/→ PAGE  ·  CTRL+ALT+O TO LOCK"
                                   Foreground="#46617A"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            Width="30"
                            Foreground="#7796B0"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Close the overlay">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FF5A4D" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="Transparent" />

            <!-- Corner grip, drawn only while interactive so the resize affordance
                 is visible rather than something the user has to guess at. -->
            <Path x:Name="Grip"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,1,1"
                  Stroke="#35C8F0"
                  StrokeThickness="1.4"
                  Opacity="0.75"
                  IsHitTestVisible="False"
                  Data="M 0,14 L 14,0 M 5,14 L 14,5 M 10,14 L 14,10" />

            <!-- Shown until the server answers. Matches the web UI's HUD styling so
                 the two halves of the app look like one product. -->
            <Border x:Name="Splash" Grid.Row="0" Grid.RowSpan="2"
                    BorderBrush="#17293C" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E80A121C" Offset="0" />
                        <GradientStop Color="#E404070C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Rectangle Height="2" Width="46" Fill="#35C8F0"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="12,0,0,0" />

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <!-- The wake mark, kept in step with web/assets/mark.svg. -->
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <Path Data="M7 45 C 13 57, 33 59, 43 47 C 50 39, 52 29, 48 21"
                                          Stroke="#35C8F0" StrokeThickness="7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M49 3 L52.8 14.2 L64 18 L52.8 21.8 L49 33 L45.2 21.8 L34 18 L45.2 14.2 Z"
                                          Fill="#7FE4FF" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="QUANTUM WAKE"
                                       Foreground="#7FE4FF"
                                       FontFamily="Bahnschrift, Segoe UI"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#35C8F0" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock x:Name="SplashText"
                                   Text="INITIALISING…"
                                   Foreground="#7796B0"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300" />

                        <TextBlock Text="BY NEKRON"
                                   Foreground="#46617A"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   Margin="0,9,0,0"
                                   HorizontalAlignment="Center" />

                        <Rectangle Height="1" Fill="#17293C" Margin="0,20,0,14" />

                        <TextBlock Text="CTRL + ALT + O   TOGGLE CLICK-THROUGH"
                                   Foreground="#46617A"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="CTRL + ALT + ← / →   CHANGE PAGE"
                                   Foreground="#46617A"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="REQUIRES BORDERLESS WINDOWED"
                                   Foreground="#46617A"
                                   FontFamily="Bahnschrift, Segoe UI"
                                   FontSize="10"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
