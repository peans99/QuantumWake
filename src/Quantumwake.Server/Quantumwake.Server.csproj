<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Quantumwake.Core\Quantumwake.Core.csproj" />
    <ProjectReference Include="..\Quantumwake.Data\Quantumwake.Data.csproj" />

    <!-- The screen reader a host without Windows OCR falls back to: the bare
         server on Linux, and a Windows machine with no English language pack. -->
    <ProjectReference Include="..\Quantumwake.Ocr.Onnx\Quantumwake.Ocr.Onnx.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Workstation GC, not the web SDK's server GC. This serves one pilot on
         their own PC, next to a game that wants the memory, so one heap is the
         right size. It is also what the desktop app already runs: the overlay
         hosts this server in-process under WPF's workstation collector, so
         Linux now matches Windows. And the server collector's dynamic heap
         sizing crashed the Linux build on start - SIGFPE, a division by zero
         in SVR::gc_heap::dynamic_heap_count_data_t::get_hc_change_freq_factors
         (gc.cpp, .NET 10.0.13), four times in about twenty-five starts on the
         Fedora test machine, never with this setting. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- The live snapshot is assembled by private methods on a background
       service, and the two things worth pinning down about it - that a note
       reaches the feed it was written for, and that a log rotation does not
       carry the last session's notes into the next - cannot be seen from
       outside it. Same arrangement Quantumwake.Core already uses. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Quantumwake.Tests" />
  </ItemGroup>

  <!-- The shared web UI ships twice, deliberately.

       Next to the binary, so an ordinary build serves files that can be edited
       without recompiling; and embedded in the assembly, so a single-file build
       has something to serve when there is no directory beside the executable.
       The loose copy wins where it exists; EmbeddedWeb is the fallback. -->
  <ItemGroup>
    <Content Include="..\..\web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />

    <EmbeddedResource Include="..\..\web\**\*">
      <LogicalName>web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Every default lives in code, so a published build needs no configuration
       file sitting beside the executable. -->
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
