<Window x:Class="SCCompanion.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SC Companion Overlay"
        Width="420" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <!-- Hosts the same web UI the browser loads, in overlay layout. -->
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="Transparent" />

        <!-- Shown until the server answers, and while the overlay is starting. -->
        <Border x:Name="Splash"
                Background="#E60E131B"
                CornerRadius="10"
                BorderBrush="#1E2735"
                BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="SC COMPANION"
                           Foreground="#35C8F0"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashText"
                           Text="Starting…"
                           Foreground="#7C8BA1"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300" />
                <TextBlock Text="Ctrl+Alt+O  toggles click-through"
                           Foreground="#4D5A6D"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
