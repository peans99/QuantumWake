<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\Quantumwake.Overlay\MfdLayout.cs" Link="MfdLayout.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quantumwake.Core\Quantumwake.Core.csproj" />
    <ProjectReference Include="..\..\src\Quantumwake.Data\Quantumwake.Data.csproj" />
    <ProjectReference Include="..\..\src\Quantumwake.LogSim\Quantumwake.LogSim.csproj" />

    <!-- For the policies that live in the server rather than in a store: what a
         machine other than this one may ask for, and what happens to the game
         folder when an install fails halfway. -->
    <ProjectReference Include="..\..\src\Quantumwake.Server\Quantumwake.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seven ships and the 173 parts they carry, cut from the community dump
         with their own totals kept, plus the small coolers, shields, plants,
         drives and S3-S4 guns a bench would swap in, so the garage sheet can be checked against
         figures it never read. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
