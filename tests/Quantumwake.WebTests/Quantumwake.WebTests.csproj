<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Jint" Version="4.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The page under test, copied in rather than read from up the tree: the tests
    then run against the same file the build ships, and a moved repo cannot
    silently test nothing.
  -->
  <ItemGroup>
    <None Include="..\..\web\app.js" Link="web\app.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\web\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="dom.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
